# Copy this file to .env on your server and fill it in. Never commit .env.

# Claude API key from https://console.anthropic.com (Settings > API keys).
# Without it the app works, but the AI features stay hidden.
ANTHROPIC_API_KEY=

# Optional: a code people must type before using AI on the public site,
# so strangers cannot spend your API credit. Recommended once it is public.
AUREALITY_ACCESS_CODE=

# Token from Cloudflare Zero Trust > Networks > Tunnels.
TUNNEL_TOKEN=
